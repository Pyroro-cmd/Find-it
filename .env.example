# ---------------------------------------------------------------------------
# Copiez ce fichier en .env.local (site) ou .env (scraper) et remplissez-le.
# NE COMMITEZ JAMAIS le fichier rempli — .gitignore l'en empêche déjà.
# ---------------------------------------------------------------------------

# --- Supabase (obligatoire, site + scraper) --------------------------------
# Tableau de bord Supabase → Project Settings → API
SUPABASE_URL=https://votre-projet.supabase.co
# La clé service_role contourne le RLS : uniquement côté serveur, jamais
# dans le navigateur, jamais dans un dépôt public.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site web (obligatoire) -------------------------------------------------
# Mot de passe unique protégeant l'accès au site.
SITE_PASSWORD=

# --- Extraction par IA (optionnel mais recommandé) --------------------------
# Sans cette clé, les annonces dont la longueur n'est pas trouvée par les
# regex restent simplement dans l'onglet « À vérifier ».
ANTHROPIC_API_KEY=

# --- Réglages du collecteur (optionnel) -------------------------------------
# LBC_CATEGORY=50                 # catégorie Nautisme de Leboncoin
# LBC_QUERIES=voilier,ketch,sloop # recherches lancées, séparées par des virgules
# LBC_MAX_PAGES=5
# LBC_MAX_PRICE=25000
# FINDIT_DISABLE_LEBONCOIN=1      # couper une source sans toucher au code
# FINDIT_DISABLE_SPECIALIZED=1
# FINDIT_DEBUG_DUMP=1             # archiver le HTML pour calibrer les sélecteurs

# --- Facebook Marketplace (phase 2 — LIRE LE README AVANT D'ACTIVER) --------
# Automatiser Marketplace viole les CGU de Meta et expose le compte utilisé à
# une suspension. N'utilisez jamais votre compte principal.
# FINDIT_ENABLE_FACEBOOK=1
# FB_STORAGE_STATE_JSON=          # session Playwright, au format JSON
# FB_CITY=paris
# FB_RADIUS_KM=500
