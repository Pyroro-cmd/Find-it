# ---------------------------------------------------------------------------
# Find-it fonctionne SANS AUCUNE CLÉ ni compte payant.
# Tout ce qui suit est facultatif. Copiez ce fichier en .env pour un usage
# local ; en production, ce sont des secrets GitHub (Settings → Secrets).
# ---------------------------------------------------------------------------

# --- Extraction par IA (facultatif, PAYANT) ---------------------------------
# Sans cette clé, la longueur est extraite par les regex et la table de
# modèles ; ce qui reste indéterminé part dans l'onglet « À vérifier ».
# Ne la renseignez que si vous acceptez une facture de quelques centimes/jour.
# ANTHROPIC_API_KEY=

# --- Réglages du collecteur (facultatif) ------------------------------------
# LBC_CATEGORY=50                 # catégorie Nautisme de Leboncoin
# LBC_QUERIES=voilier,ketch,sloop # recherches lancées, séparées par des virgules
# LBC_MAX_PAGES=5
# LBC_MAX_PRICE=25000
# FINDIT_DISABLE_LEBONCOIN=1      # couper une source sans toucher au code
# FINDIT_DISABLE_SPECIALIZED=1
# FINDIT_DEBUG_DUMP=1             # archiver le HTML pour calibrer les sélecteurs
# FINDIT_DATA_FILE=web/public/data/listings.json

# --- Facebook Marketplace (phase 2 — LIRE LE README AVANT D'ACTIVER) --------
# Automatiser Marketplace viole les CGU de Meta et expose le compte utilisé à
# une suspension. N'utilisez jamais votre compte principal.
# FINDIT_ENABLE_FACEBOOK=1
# FB_STORAGE_STATE_JSON=          # session Playwright, au format JSON
# FB_CITY=paris
# FB_RADIUS_KM=500
