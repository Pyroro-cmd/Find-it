{
  "name": "findit-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Collecte quotidienne des annonces de voiliers pour Find-it",
  "scripts": {
    "scrape": "tsx src/index.ts",
    "collecte:locale": "tsx src/collecte-locale.ts",
    "facebook:connexion": "tsx src/facebook-connexion.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "probe": "tsx src/probe.ts",
    "probe:deep": "tsx src/probe-deep.ts",
    "probe:search": "tsx src/probe-search.ts",
    "probe:sources": "tsx src/probe-sources.ts",
    "probe:lbc": "tsx src/probe-lbc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "cheerio": "^1.0.0",
    "playwright": "^1.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
